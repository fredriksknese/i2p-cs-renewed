<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
    </PropertyGroup>

    <!--
        Batch 6-1 (docs/PRODUCTION-PLAN.md) removed the verbose logging category switches that
        lived here: NOLOG_ALL_TUNNEL_TRANSFER and five siblings, inert placeholders for #if
        LOG_X guards in the source. Selecting a category meant editing this file and rebuilding,
        which is the compile-time gating batch 0-1 removed from the rest of the logging and for
        the same reason — the output you need to diagnose a router is unreachable in the build
        you already have.

        The categories are now runtime flags: see TraceCategories.cs and the CLI's log-trace
        option. Do not
        reintroduce a build-time switch here; NoCompileTimeTraceGates in TunnelTracingTest fails
        if a #if LOG_ guard reappears anywhere under I2PCore.
    -->

    <ItemGroup>
        <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0-beta.98"/>
        <PackageReference Include="System.Configuration.ConfigurationManager" Version="10.0.2"/>
    </ItemGroup>

    <ItemGroup>
        <None Include="certificates\reseed\*.crt">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <Link>certificates\reseed\%(Filename)%(Extension)</Link>
        </None>
    </ItemGroup>

</Project>
