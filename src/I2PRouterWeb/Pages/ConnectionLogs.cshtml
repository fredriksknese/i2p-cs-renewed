@page
@model ConnectionLogsModel
@{
    ViewData["Title"] = "Transport Connection Logs";
}

<div class="row mb-3">
    <div class="col-12">
        <div class="d-flex justify-content-between align-items-center">
            <h1>Transport Connection Logs</h1>
            <a href="/ConnectionLogs" class="btn btn-outline-secondary btn-sm">
                Refresh
            </a>
        </div>
        <p class="text-muted">Connection statistics and verbose logging of NTCP2 and SSU2 connection attempts.</p>
    </div>
</div>

@* ── Connection Stats ── *@
<div class="row mb-4">
    <div class="col-12">
        <div class="card">
            <div class="card-header"><h5 class="mb-0">Connection Statistics</h5></div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-dark">
                        <tr>
                            <th>Transport</th>
                            <th>Direction</th>
                            <th class="text-end">Successful</th>
                            <th class="text-end">Failed</th>
                            <th class="text-end">Total</th>
                            <th class="text-end">Success Rate</th>
                        </tr>
                        </thead>
                        <tbody>
                        @{
                            var rows = new[]
                            {
                                ("NTCP2", "Inbound", Model.Stats.Ntcp2InboundSuccess, Model.Stats.Ntcp2InboundFailed),
                                ("NTCP2", "Outbound", Model.Stats.Ntcp2OutboundSuccess, Model.Stats.Ntcp2OutboundFailed),
                                ("SSU2", "Inbound", Model.Stats.Ssu2InboundSuccess, Model.Stats.Ssu2InboundFailed),
                                ("SSU2", "Outbound", Model.Stats.Ssu2OutboundSuccess, Model.Stats.Ssu2OutboundFailed),
                            };
                        }
                        @foreach (var (transport, direction, success, failed) in rows)
                        {
                            var total = success + failed;
                            var rate = total > 0 ? (100.0 * success / total) : 0;
                            <tr>
                                <td>
                                    @if (transport == "NTCP2")
                                    {
                                        <span class="badge bg-primary">NTCP2</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-info text-dark">SSU2</span>
                                    }
                                </td>
                                <td>
                                    @if (direction == "Inbound")
                                    {
                                        <span class="badge bg-info">Inbound</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Outbound</span>
                                    }
                                </td>
                                <td class="text-end text-success fw-bold">@success.ToString("N0")</td>
                                <td class="text-end text-danger fw-bold">@failed.ToString("N0")</td>
                                <td class="text-end">@total.ToString("N0")</td>
                                <td class="text-end">
                                    @if (total > 0)
                                    {
                                        var badgeClass = rate >= 80 ? "bg-success" : rate >= 50 ? "bg-warning text-dark" : "bg-danger";
                                        <span class="badge @badgeClass">@rate.ToString("F1")%</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@* ── Top Failure Reasons ── *@
<div class="row mb-4">
    @{
        var failureSections = new[]
        {
            ("NTCP2", "Inbound", Model.Ntcp2InboundFailures),
            ("NTCP2", "Outbound", Model.Ntcp2OutboundFailures),
            ("SSU2", "Inbound", Model.Ssu2InboundFailures),
            ("SSU2", "Outbound", Model.Ssu2OutboundFailures),
        };
    }
    @foreach (var (transport, direction, failures) in failureSections)
    {
        <div class="col-md-6 mb-3">
            <div class="card h-100">
                <div class="card-header">
                    <h6 class="mb-0">
                        Top 30
                        @if (transport == "NTCP2")
                        {
                            <span class="badge bg-primary">NTCP2</span>
                        }
                        else
                        {
                            <span class="badge bg-info text-dark">SSU2</span>
                        }
                        @if (direction == "Inbound")
                        {
                            <span class="badge bg-info">Inbound</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Outbound</span>
                        }
                        Failure Reasons
                    </h6>
                </div>
                <div class="card-body p-0">
                    @if (failures.Any())
                    {
                        <table class="table table-sm table-hover mb-0">
                            <thead>
                            <tr>
                                <th>Reason</th>
                                <th class="text-end" style="width: 60px;">Count</th>
                                <th class="text-end" style="width: 50px;"></th>
                            </tr>
                            </thead>
                            <tbody>
                            @{ var idx = 0; }
                            @foreach (var (reason, count, routers) in failures)
                            {
                                var collapseId = $"collapse-{transport}-{direction}-{idx++}";
                                <tr>
                                    <td class="small text-break" data-bs-toggle="collapse" data-bs-target="#@collapseId" style="cursor: pointer;">
                                        <span class="me-1">▶</span>
                                        @reason
                                    </td>
                                    <td class="text-end fw-bold" data-bs-toggle="collapse" data-bs-target="#@collapseId" style="cursor: pointer;">@count</td>
                                    <td class="text-end">
                                        <a asp-page-handler="ExportCsv"
                                           asp-route-transport="@transport"
                                           asp-route-direction="@direction"
                                           asp-route-reason="@reason"
                                           class="btn btn-sm btn-outline-primary py-0 fw-bold"
                                           style="font-size: 0.7rem;"
                                           title="Export to CSV">
                                            CSV
                                        </a>
                                    </td>
                                </tr>
                                <tr class="collapse" id="@collapseId">
                                    <td colspan="3" class="bg-body-tertiary border-start border-3 border-primary">
                                        <div class="ps-3 py-2">
                                            @if (routers.Any())
                                            {
                                                <div class="small text-muted mb-2">Affected Routers / IPs (up to 50):</div>
                                                @foreach (var router in routers)
                                                {
                                                    <div class="mb-1 d-flex flex-wrap align-items-center">
                                                        <span class="me-2 text-primary">@(router.FullId.Contains(":") ? "📍" : "🌐")</span>
                                                        @if (router.FullId.Contains(":"))
                                                        {
                                                            <span class="font-monospace small fw-bold me-2">@router.ShortId</span>
                                                        }
                                                        else
                                                        {
                                                            <a href="/RouterDetail?hash=@Uri.EscapeDataString(router.ShortId)"
                                                               class="text-decoration-none font-monospace small fw-bold me-2">
                                                                @router.ShortId
                                                            </a>
                                                        }
                                                        <span class="text-muted font-monospace" style="font-size: 0.7rem;">@router.FullId</span>
                                                    </div>
                                                }
                                            }
                                            else
                                            {
                                                <div class="text-muted small">No router details available.</div>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <div class="text-center py-3 text-muted small">No failures recorded.</div>
                    }
                </div>
            </div>
        </div>
    }
</div>

@* ── Top Failed Routers / IPs ── *@
<div class="row mb-4">
    <div class="col-12">
        <hr class="my-4" />
        <h4 class="mb-3">Top Failed Routers / IPs</h4>
        <p class="text-muted small">Summary of failure reasons grouped by the most frequent remote endpoints.</p>
    </div>
    @{
        var failedRouterSections = new[]
        {
            ("NTCP2", "Inbound", Model.Ntcp2InboundFailedRouters),
            ("NTCP2", "Outbound", Model.Ntcp2OutboundFailedRouters),
            ("SSU2", "Inbound", Model.Ssu2InboundFailedRouters),
            ("SSU2", "Outbound", Model.Ssu2OutboundFailedRouters),
        };
    }
    @foreach (var (transport, direction, routers) in failedRouterSections)
    {
        <div class="col-md-6 mb-3">
            <div class="card h-100">
                <div class="card-header">
                    <h6 class="mb-0">
                        Top 30
                        @if (transport == "NTCP2")
                        {
                            <span class="badge bg-primary">NTCP2</span>
                        }
                        else
                        {
                            <span class="badge bg-info text-dark">SSU2</span>
                        }
                        @if (direction == "Inbound")
                        {
                            <span class="badge bg-info">Inbound</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Outbound</span>
                        }
                        Failed Routers / IPs
                    </h6>
                </div>
                <div class="card-body p-0">
                    @if (routers.Any())
                    {
                        <table class="table table-sm table-hover mb-0">
                            <thead>
                            <tr>
                                <th>Router / IP</th>
                                <th class="text-end" style="width: 80px;">Failures</th>
                            </tr>
                            </thead>
                            <tbody>
                            @{ var rIdx = 0; }
                            @foreach (var (shortId, fullId, count, reasons) in routers)
                            {
                                var rCollapseId = $"collapse-router-{transport}-{direction}-{rIdx++}";
                                <tr>
                                    <td class="small text-break" data-bs-toggle="collapse" data-bs-target="#@rCollapseId" style="cursor: pointer;">
                                        <div class="d-flex align-items-start">
                                            <span class="me-2">▶</span>
                                            <div>
                                                <span class="me-1">@(fullId.Contains(":") ? "📍" : "🌐")</span>
                                                @if (fullId.Contains(":"))
                                                {
                                                    <span class="font-monospace small fw-bold">@shortId</span>
                                                }
                                                else
                                                {
                                                    <a href="/RouterDetail?hash=@Uri.EscapeDataString(shortId)"
                                                       class="text-decoration-none font-monospace small fw-bold"
                                                       onclick="event.stopPropagation();">
                                                        @shortId
                                                    </a>
                                                }
                                                <div class="text-muted font-monospace" style="font-size: 0.7rem;">@fullId</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="text-end fw-bold align-middle" data-bs-toggle="collapse" data-bs-target="#@rCollapseId" style="cursor: pointer;">@count</td>
                                </tr>
                                <tr class="collapse" id="@rCollapseId">
                                    <td colspan="2" class="bg-body-tertiary border-start border-3 border-info">
                                        <div class="ps-4 py-2">
                                            @if (reasons.Any())
                                            {
                                                <div class="small text-muted mb-1 fw-bold">Reasons for failure:</div>
                                                @foreach (var r in reasons)
                                                {
                                                    <div class="small d-flex justify-content-between mb-1 border-bottom border-secondary-subtle pb-1">
                                                        <span class="text-danger-emphasis me-2">@r.Reason</span>
                                                        <span class="fw-bold">@r.Count</span>
                                                    </div>
                                                }
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <div class="text-center py-3 text-muted small">No failures recorded.</div>
                    }
                </div>
            </div>
        </div>
    }
</div>

@* ── Verbose Connection Logs ── *@
<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header"><h5 class="mb-0">Verbose Connection Logs</h5></div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover table-striped mb-0">
                        <thead class="table-dark">
                        <tr>
                            <th style="width: 180px;">Timestamp</th>
                            <th style="width: 100px;">Transport</th>
                            <th style="width: 100px;">Dir</th>
                            <th style="width: 120px;">Router</th>
                            <th>Message</th>
                        </tr>
                        </thead>
                        <tbody>
                        @if (Model.Logs.Any())
                        {
                            foreach (var log in Model.Logs)
                            {
                                <tr>
                                    <td class="text-nowrap small text-muted">@log.Timestamp.ToString("yyyy-MM-dd HH:mm:ss.fff")</td>
                                    <td>
                                        @if (log.Transport == "NTCP2")
                                        {
                                            <span class="badge bg-primary">NTCP2</span>
                                        }
                                        else if (log.Transport == "SSU2")
                                        {
                                            <span class="badge bg-info text-dark">SSU2</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">@log.Transport</span>
                                        }
                                    </td>
                                    <td>
                                        @if (log.Direction == "Inbound")
                                        {
                                            <span class="badge bg-info">Inbound</span>
                                        }
                                        else if (log.Direction == "Outbound")
                                        {
                                            <span class="badge bg-secondary">Outbound</span>
                                        }
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(log.RouterId))
                                        {
                                            <a href="/RouterDetail?hash=@Uri.EscapeDataString(log.RouterId)"
                                               class="text-decoration-none font-monospace small">@log.RouterId</a>
                                        }
                                        else if (log.RemoteEndPoint != null)
                                        {
                                            <span class="text-muted font-monospace small" title="@log.RemoteEndPoint">
                                                @log.RemoteEndPoint.Address
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">-</span>
                                        }
                                    </td>
                                    <td class="small">@log.Message</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center py-4 text-muted">
                                    No connection logs found.
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
