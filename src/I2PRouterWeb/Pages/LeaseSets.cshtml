@page
@model LeaseSetsModel
@{
    ViewData["Title"] = "Lease Sets";
}

<div class="row mb-3">
    <div class="col-12">
        <h1 class="mb-4">Lease Sets</h1>
        <p class="text-muted">Published and stored lease sets in the network database</p>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card text-center">
            <div class="card-body">
                <h5 class="card-title">Total Lease Sets</h5>
                <p class="display-6">@Model.TotalCount</p>
            </div>
        </div>
    </div>
</div>

@if (Model.LeaseSets.Any())
{
    <div class="table-responsive">
        <table class="table table-striped table-sm">
            <thead>
                <tr>
                    <th>Destination</th>
                    <th>Type</th>
                    <th>Leases</th>
                    <th>Expires</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var ls in Model.LeaseSets)
                {
                    <tr>
                        <td><code>@ls.DestHash</code></td>
                        <td>@ls.LeaseSetType</td>
                        <td>@ls.LeaseCount</td>
                        <td>@ls.Expiration</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="alert alert-info">No lease sets currently stored.</div>
}
