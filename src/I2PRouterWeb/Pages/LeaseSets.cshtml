@page
@model LeaseSetsModel
@{
    ViewData["Title"] = "Lease Sets";
}

<div class="row mb-3">
    <div class="col-12">
        <h1 class="mb-2">Lease Sets</h1>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card stat-card">
            <div class="card-body py-2">
                <h6 class="card-subtitle mb-1 text-muted small">Total Lease Sets</h6>
                <h3 class="mb-0">@Model.TotalCount</h3>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card stat-card">
            <div class="card-body py-2">
                <h6 class="card-subtitle mb-1 text-muted small">Total Leases</h6>
                <h3 class="mb-0">@Model.LeaseSets.Sum(ls => ls.Leases.Count)</h3>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card stat-card">
            <div class="card-body py-2">
                <h6 class="card-subtitle mb-1 text-muted small">Updated</h6>
                <p class="mb-0 small">@DateTime.Now.ToString("HH:mm:ss")</p>
            </div>
        </div>
    </div>
</div>

@if (Model.LeaseSets.Any())
{
    @foreach (var ls in Model.LeaseSets)
    {
        var ttl = ls.Expiration - DateTime.UtcNow;
        var ttlClass = ttl.TotalMinutes < 2 ? "text-danger" : ttl.TotalMinutes < 5 ? "text-warning" : "text-success";

        <div class="card mb-3">
            <div class="card-header py-2 d-flex justify-content-between align-items-center">
                <div>
                    <strong>@ls.DestHashShort</strong>
                    <span class="badge bg-secondary ms-2">@ls.LeaseSetType</span>
                    <span class="badge bg-info ms-1">@ls.TypeClassName</span>
                    <span class="badge bg-primary ms-1">@ls.Leases.Count lease(s)</span>
                </div>
                <div>
                    <span class="@ttlClass small fw-bold">
                        TTL: @($"{ttl.Minutes:D2}m {ttl.Seconds:D2}s")
                    </span>
                </div>
            </div>
            <div class="card-body p-3">
                <!-- B32 Address -->
                <div class="mb-2">
                    <strong class="small text-muted">B32 Address:</strong>
                    <code class="small">@ls.B32Address</code>
                </div>

                <!-- Full Destination -->
                <div class="mb-2">
                    <strong class="small text-muted">Destination (Base64):</strong>
                    <div class="bg-body-secondary border rounded p-2 mt-1" style="max-height: 80px; overflow-y: auto;">
                        <code class="small"
                              style="word-break: break-all; font-size: 0.7rem;">@ls.DestinationBase64</code>
                    </div>
                </div>

                <!-- Expiration -->
                <div class="mb-2">
                    <strong class="small text-muted">Expires:</strong>
                    <span class="small">@ls.Expiration.ToString("yyyy-MM-dd HH:mm:ss") UTC</span>
                </div>

                <!-- Public Keys -->
                @if (ls.PublicKeys.Any())
                {
                    <div class="mb-2">
                        <strong class="small text-muted">Public Keys (@ls.PublicKeys.Count):</strong>
                        <div class="ms-2 mt-1">
                            @foreach (var pk in ls.PublicKeys)
                            {
                                <div class="mb-1">
                                    <span class="badge border border-secondary text-body-emphasis small">@pk.KeyType</span>
                                    <span class="text-muted small">(@pk.KeyLength bytes)</span>
                                    <div class="bg-body-secondary border rounded p-1 mt-1"
                                         style="max-height: 50px; overflow-y: auto;">
                                        <code style="word-break: break-all; font-size: 0.65rem;">@pk.KeyBase64</code>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }

                <!-- Leases -->
                @if (ls.Leases.Any())
                {
                    <div>
                        <strong class="small text-muted">Leases (@ls.Leases.Count):</strong>
                        <div class="table-responsive mt-1">
                            <table class="table table-sm table-bordered mb-0" style="font-size: 0.85rem;">
                                <thead>
                                <tr class="table-active">
                                    <th>Tunnel Gateway</th>
                                    <th>Gateway B32</th>
                                    <th>Tunnel ID</th>
                                    <th>Expires</th>
                                    <th>TTL</th>
                                </tr>
                                </thead>
                                <tbody>
                                @foreach (var lease in ls.Leases)
                                {
                                    var leaseTtl = lease.Expiration - DateTime.UtcNow;
                                    var leaseTtlClass = leaseTtl.TotalMinutes < 2 ? "text-danger" : leaseTtl.TotalMinutes < 5 ? "text-warning" : "text-success";

                                    <tr>
                                        <td><code>@lease.TunnelGatewayHash</code></td>
                                        <td>
                                            <code class="small"
                                                  style="font-size: 0.7rem; word-break: break-all;">@lease.TunnelGatewayB32</code>
                                        </td>
                                        <td><code>@lease.TunnelId</code></td>
                                        <td class="text-nowrap">@lease.Expiration.ToString("HH:mm:ss") UTC</td>
                                        <td class="text-nowrap @leaseTtlClass fw-bold">
                                            @($"{leaseTtl.Minutes:D2}m {leaseTtl.Seconds:D2}s")
                                        </td>
                                    </tr>
                                }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }
                else
                {
                    <div class="text-muted small fst-italic">No active leases</div>
                }
            </div>
        </div>
    }
}
else
{
    <div class="alert alert-info">No lease sets currently stored.</div>
}

