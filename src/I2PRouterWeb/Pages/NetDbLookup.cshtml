@page
@model NetDbLookupModel
@{
    ViewData["Title"] = "NetDB Lookup";
}

<div class="row mb-3">
    <div class="col-12">
        <h1 class="mb-4">NetDB Lookup</h1>
        <p class="text-muted">Look up a .b32.i2p address to retrieve LeaseSet information from floodfill routers</p>
    </div>
</div>

<div class="row mb-4">
    <div class="col-md-8">
        <div class="card">
            <div class="card-body">
                <form method="post">
                    <div class="mb-3">
                        <label for="b32Address" class="form-label">b32 Address</label>
                        <input type="text" class="form-control font-monospace" id="b32Address" name="b32Address"
                               placeholder="xxxxxxxx.b32.i2p" value="@Model.B32Address"
                               aria-describedby="b32Help">
                        <div id="b32Help" class="form-text mb-3">Enter a .b32.i2p address to look up its LeaseSet via
                            the NetDB
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label for="parallelQueries" class="form-label">Parallel Queries</label>
                            <input type="number" class="form-control" id="parallelQueries" name="parallelQueries"
                                   min="1" max="20" value="@Model.ParallelQueries">
                            <div class="form-text">Number of floodfills to query simultaneously</div>
                        </div>
                        <div class="col-md-6">
                            <label for="tunnelPool" class="form-label">Tunnel Pool</label>
                            <select class="form-select" id="tunnelPool" name="tunnelPool">
                                @foreach (var pool in Model.AvailableTunnelPools)
                                {
                                    <option value="@pool.Value" selected="@(pool.Value == Model.TunnelPool)">@pool.Text</option>
                                }
                            </select>
                            <div class="form-text">Which tunnel pool to route the lookup through</div>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary">Lookup</button>
                </form>
            </div>
        </div>
    </div>
</div>

@if (Model.IsLookupInProgress)
{
    <div class="alert alert-info">
        <div class="spinner-border spinner-border-sm me-2" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
        Looking up LeaseSet for <code>@Model.B32Address</code>... This may take up to 30 seconds.
    </div>
}

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

@if (Model.Result != null)
{
    <div class="row">
        <div class="col-md-10">
            @if (Model.Result.LeaseSetType != "None")
            {
                <div class="card border-success mb-4">
                    <div class="card-header bg-success text-white">
                        <h5 class="card-title mb-0">LeaseSet Found</h5>
                    </div>
                    <div class="card-body">
                        <dl class="row mb-0">
                            <dt class="col-sm-4">Destination Hash</dt>
                            <dd class="col-sm-8"><code>@Model.Result.DestinationHash</code></dd>

                            <dt class="col-sm-4">LeaseSet Type</dt>
                            <dd class="col-sm-8"><span class="badge bg-info text-dark">@Model.Result.LeaseSetType</span>
                            </dd>

                            <dt class="col-sm-4">Expires</dt>
                            <dd class="col-sm-8">@Model.Result.Expiration</dd>

                            <dt class="col-sm-4">Lookup Time</dt>
                            <dd class="col-sm-8">@Model.Result.LookupTimeMs ms</dd>
                        </dl>
                    </div>
                </div>

                @if (Model.Result.EncryptionKeys.Any())
                {
                    <div class="card mb-4">
                        <div class="card-header">
                            <h6 class="mb-0">Encryption Keys (@Model.Result.EncryptionKeys.Count)</h6>
                        </div>
                        <div class="card-body p-0">
                            <table class="table table-striped table-sm mb-0">
                                <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Key Type</th>
                                    <th>Key Size</th>
                                </tr>
                                </thead>
                                <tbody>
                                @for (var i = 0; i < Model.Result.EncryptionKeys.Count; i++)
                                {
                                    var key = Model.Result.EncryptionKeys[i];
                                    <tr>
                                        <td>@(i + 1)</td>
                                        <td><span class="badge bg-primary">@key.KeyType</span></td>
                                        <td>@key.KeySizeBytes bytes</td>
                                    </tr>
                                }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }

                @if (Model.Result.Leases.Any())
                {
                    <div class="card mb-4">
                        <div class="card-header">
                            <h6 class="mb-0">Leases (@Model.Result.Leases.Count)</h6>
                        </div>
                        <div class="card-body p-0">
                            <table class="table table-striped table-sm mb-0">
                                <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Tunnel Gateway</th>
                                    <th>Tunnel ID</th>
                                    <th>Expires</th>
                                </tr>
                                </thead>
                                <tbody>
                                @for (var i = 0; i < Model.Result.Leases.Count; i++)
                                {
                                    var lease = Model.Result.Leases[i];
                                    <tr>
                                        <td>@(i + 1)</td>
                                        <td><code>@lease.GatewayHash</code></td>
                                        <td><code>@lease.TunnelId</code></td>
                                        <td>@lease.EndDate</td>
                                    </tr>
                                }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }
            }

            @if (Model.Result.History.Any())
            {
                <div class="card mb-4">
                    <div class="card-header bg-body-secondary">
                        <h6 class="mb-0">NetDb Lookup Process Details</h6>
                    </div>
                    <div class="card-body">
                        <div class="accordion" id="lookupHistoryAccordion">
                            @for (var i = 0; i < Model.Result.History.Count; i++)
                            {
                                var attempt = Model.Result.History[i];
                                <div class="accordion-item">
                                    <h2 class="accordion-header" id="heading-@i">
                                        <button
                                            class="accordion-button @(i == Model.Result.History.Count - 1 ? "" : "collapsed")"
                                            type="button" data-bs-toggle="collapse" data-bs-target="#collapse-@i"
                                            aria-expanded="@(i == Model.Result.History.Count - 1 ? "true" : "false")"
                                            aria-controls="collapse-@i">
                                            Attempt @(i + 1) (+@attempt.StartMs ms)
                                        </button>
                                    </h2>
                                    <div id="collapse-@i"
                                         class="accordion-collapse collapse @(i == Model.Result.History.Count - 1 ? "show" : "")"
                                         aria-labelledby="heading-@i" data-bs-parent="#lookupHistoryAccordion">
                                        <div class="accordion-body">
                                            <div class="row mb-3">
                                                <div class="col-md-6">
                                                    <strong>Outbound Tunnel Gateway:</strong><br/>
                                                    <code>@attempt.OutboundTunnel</code>
                                                </div>
                                                <div class="col-md-6">
                                                    <strong>Inbound (Reply) Tunnel Gateway:</strong><br/>
                                                    <code>@attempt.InboundTunnel</code>
                                                </div>
                                            </div>
                                            @if (!string.IsNullOrEmpty(attempt.Details))
                                            {
                                                <div class="alert alert-warning py-1 px-2 mb-3">
                                                    <small><strong>Info:</strong> @attempt.Details</small>
                                                </div>
                                            }
                                            @if (attempt.Floodfills.Any())
                                            {
                                                <div>
                                                    <strong>Floodfills Queried:</strong><br/>
                                                    <div class="d-flex flex-wrap gap-2 mt-1">
                                                        @foreach (var ff in attempt.Floodfills)
                                                        {
                                                            <div class="mb-1">
                                                                <span
                                                                    class="badge @(ff.Response == "DatabaseStore" ? "bg-success" : ff.Response == "NoResponse" ? "bg-secondary" : ff.Response == "Timeout" || ff.Response == "SendFailed" ? "bg-danger" : "bg-warning text-dark")">
                                                                    @ff.Floodfill: @ff.Response
                                                                </span>
                                                                @if (!string.IsNullOrEmpty(ff.Details))
                                                                {
                                                                    <small class="ms-1 text-muted">(@ff.Details)</small>
                                                                }
                                                            </div>
                                                        }
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
}
