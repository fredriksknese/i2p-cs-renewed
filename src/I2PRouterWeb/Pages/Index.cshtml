@page
@using I2PCore.Data
@using I2PCore.Utils
@model IndexModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="row mb-3">
    <div class="col-12">
        <div class="d-flex justify-content-between align-items-center">
            <h1 class="mb-0">I2P Router Dashboard</h1>
            <div>
                @if (Model.RouterStats.IsRunning)
                {
                    <span class="badge bg-success fs-6 me-2">Running</span>
                    <form method="post" asp-page-handler="Reseed" class="d-inline">
                        <button type="submit" class="btn btn-outline-primary me-2">
                            <i class="bi bi-download"></i> Reseed
                        </button>
                    </form>
                    <form method="post" asp-page-handler="Stop" class="d-inline">
                        <button type="submit" class="btn btn-outline-danger">
                            <i class="bi bi-stop-circle"></i> Stop Router
                        </button>
                    </form>
                    @if (Model.RouterStats.HTTPProxyRunning)
                    {
                        <span class="badge bg-info fs-6 ms-3 me-2">Proxy :@Model.RouterStats.HTTPProxyPort</span>
                        <form method="post" asp-page-handler="StopProxy" class="d-inline">
                            <button type="submit" class="btn btn-outline-warning btn-sm">
                                Stop HTTP Proxy
                            </button>
                        </form>
                    }
                    else
                    {
                        <form method="post" asp-page-handler="StartProxy" class="d-inline ms-3">
                            <button type="submit" class="btn btn-outline-info">
                                Start HTTP Proxy
                            </button>
                        </form>
                    }
                }
                else
                {
                    <span class="badge bg-secondary fs-6 me-2">Stopped</span>
                    <form method="post" asp-page-handler="Start" class="d-inline">
                        <button type="submit" class="btn btn-outline-success">
                            <i class="bi bi-play-circle"></i> Start Router
                        </button>
                    </form>
                }
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-6 col-lg-3">
        <div class="card stat-card">
            <div class="card-body">
                <h6 class="card-subtitle mb-2 text-muted">Router Hash</h6>
                <p class="card-text router-hash">@Model.RouterStats.RouterHash</p>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-lg-3">
        <div class="card stat-card">
            <div class="card-body">
                <h6 class="card-subtitle mb-2 text-muted">Version</h6>
                <p class="card-text">@Model.RouterStats.Version</p>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-lg-3">
        <div class="card stat-card">
            <div class="card-body">
                <h6 class="card-subtitle mb-2 text-muted">Uptime</h6>
                <p class="card-text">@Model.FormattedUptime</p>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-lg-3">
        <div class="card stat-card">
            <div class="card-body">
                <h6 class="card-subtitle mb-2 text-muted">Key Type</h6>
                <p class="card-text">@Model.RouterStats.KeyType</p>
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-6 col-lg-3">
        <div class="card stat-card">
            <div class="card-body">
                <h6 class="card-subtitle mb-2 text-muted">Known Routers</h6>
                <p class="card-text fs-4">@Model.RouterStats.KnownRouters</p>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-lg-3">
        <div class="card stat-card">
            <div class="card-body">
                <h6 class="card-subtitle mb-2 text-muted">Floodfills</h6>
                <p class="card-text fs-4">@Model.RouterStats.KnownFloodfills</p>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-lg-3">
        <div class="card stat-card">
            <div class="card-body">
                <h6 class="card-subtitle mb-2 text-muted">Bandwidth Class</h6>
                <p class="card-text fs-4">@Model.RouterStats.BandwidthClass</p>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-lg-3">
        <div class="card stat-card">
            <div class="card-body">
                <h6 class="card-subtitle mb-2 text-muted">Transport Sessions</h6>
                <p class="card-text fs-4">NTCP2: @Model.RouterStats.NTCP2SessionCount /
                    SSU2: @Model.RouterStats.SSU2SessionCount</p>
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-6 col-lg-3">
        <div class="card stat-card">
            <div class="card-body">
                <h6 class="card-subtitle mb-2 text-muted">Inbound Tunnels</h6>
                <p class="card-text fs-4 text-success">@Model.RouterStats.InboundTunnels</p>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-lg-3">
        <div class="card stat-card">
            <div class="card-body">
                <h6 class="card-subtitle mb-2 text-muted">Outbound Tunnels</h6>
                <p class="card-text fs-4 text-primary">@Model.RouterStats.OutboundTunnels</p>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-lg-3">
        <div class="card stat-card">
            <div class="card-body">
                <h6 class="card-subtitle mb-2 text-muted">Exploratory Tunnels</h6>
                <p class="card-text fs-4 text-warning">@Model.RouterStats.ExploratoryTunnels</p>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-lg-3">
        <div class="card stat-card">
            <div class="card-body">
                <h6 class="card-subtitle mb-2 text-muted">Transit Tunnels</h6>
                <p class="card-text fs-4 text-secondary">@Model.RouterStats.TransitTunnels</p>
            </div>
        </div>
    </div>
</div>

<div class="row mb-4">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">Quick Links</h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-4 mb-3">
                        <a href="/Tunnels" class="btn btn-outline-primary w-100">
                            View Tunnels
                        </a>
                    </div>
                    <div class="col-md-4 mb-3">
                        <a href="/Routers" class="btn btn-outline-primary w-100">
                            Known Routers
                        </a>
                    </div>
                    <div class="col-md-4 mb-3">
                        <a href="/Settings" class="btn btn-outline-primary w-100">
                            Settings
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row mb-4">
    <div class="col-12">
        <div class="card">
            <div class="card-header bg-body-secondary border-bottom">
                <h5 class="mb-0">Manual Reseed</h5>
            </div>
            <div class="card-body">
                <p class="card-text text-muted mb-3 small">
                    If automatic reseed fails, you can manually upload a <strong>.su3</strong> or <strong>.zip</strong>
                    reseed file.
                    These files contain RouterInfo for bootstrapping the network.
                </p>
                <form method="post" asp-page-handler="ManualReseed" enctype="multipart/form-data"
                      class="row g-2 align-items-center">
                    <div class="col-auto">
                        <input type="file" name="reseedFile" class="form-control form-control-sm" accept=".su3,.zip"
                               required>
                    </div>
                    <div class="col-auto">
                        <button type="submit" class="btn btn-outline-primary btn-sm">
                            <i class="bi bi-upload me-1"></i> Upload and Import
                        </button>
                    </div>
                </form>
                @if (TempData["ReseedMessage"] != null)
                {
                    <div class="alert alert-info mt-2 mb-0 py-1 small">
                        <i class="bi bi-info-circle me-1"></i> @TempData["ReseedMessage"]
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0">Recent Activity</h5>
                <a href="/Activity" class="btn btn-sm btn-outline-primary">View All</a>
            </div>
            <div class="card-body">
                @if (Model.RecentActivity.Any())
                {
                    <div class="list-group">
                        @foreach (var entry in Model.RecentActivity)
                        {
                            <div class="list-group-item">
                                <div class="d-flex w-100 justify-content-between">
                                    <div>
                                        <span class="badge bg-secondary badge-category">@entry.Category</span>
                                        <span class="ms-2">@entry.Message</span>
                                    </div>
                                    <small class="text-muted">@entry.Timestamp.ToString("HH:mm:ss")</small>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="text-muted mb-0">No recent activity</p>
                }
            </div>
        </div>
    </div>
</div>

@if (Model.RouterStats.FullRouterInfo != null)
{
    var ri = Model.RouterStats.FullRouterInfo;
    <div class="row mt-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header bg-body-tertiary border-bottom d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Full Router Info</h5>
                    <span class="badge bg-body-secondary text-primary">Published: @ri.PublishedDate</span>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <h6>Identity</h6>
                            <table class="table table-sm table-bordered">
                                <tr>
                                    <th style="width: 30%">Full Hash (B64)</th>
                                    <td class="text-break"><code>@ri.Identity.IdentHash.Id64</code></td>
                                </tr>
                                <tr>
                                    <th>Full Hash (B32)</th>
                                    <td class="text-break"><code>@ri.Identity.IdentHash.Id32</code></td>
                                </tr>
                                <tr>
                                    <th>Certificate</th>
                                    <td>@ri.Identity.Certificate</td>
                                </tr>
                                <tr>
                                    <th>Public Key</th>
                                    <td class="text-break"><code>@FreenetBase64.Encode(new I2PByteBlock(ri.Identity.PublicKey.ToByteArray()))</code></td>
                                </tr>
                                <tr>
                                    <th>Signing Key</th>
                                    <td class="text-break"><code>@FreenetBase64.Encode(new I2PByteBlock(ri.Identity.SigningPublicKey.ToByteArray()))</code></td>
                                </tr>
                            </table>

                            <h6 class="mt-4">Router Options</h6>
                            @if (ri.Options.Any())
                            {
                                <table class="table table-sm table-striped">
                                    <thead>
                                    <tr class="table-active">
                                        <th>Key</th>
                                        <th>Value</th>
                                    </tr>
                                    </thead>
                                    <tbody>
                                    @foreach (var opt in ri.Options)
                                    {
                                        <tr>
                                            <td><code>@opt.Key</code></td>
                                            <td class="text-break">@opt.Value</td>
                                        </tr>
                                    }
                                    </tbody>
                                </table>
                            }
                            else
                            {
                                <p class="text-muted small">No options defined.</p>
                            }
                        </div>

                        <div class="col-md-6">
                            <h6>Addresses</h6>
                            @if (ri.Addresses != null && ri.Addresses.Any())
                            {
                                foreach (var addr in ri.Addresses)
                                {
                                    <div class="card mb-3 shadow-sm">
                                        <div class="card-header py-1 bg-body-secondary">
                                            <strong>@addr.TransportStyle</strong>
                                            <span class="badge bg-secondary float-end">Cost: @addr.Cost</span>
                                        </div>
                                        <div class="card-body py-2">
                                            @if (addr.Options.Any())
                                            {
                                                <table class="table table-sm table-borderless mb-0">
                                                    @foreach (var opt in addr.Options)
                                                    {
                                                        <tr>
                                                            <th style="width: 30%" class="py-0 small">@opt.Key</th>
                                                            <td class="py-0 small text-break">@opt.Value</td>
                                                        </tr>
                                                    }
                                                </table>
                                            }
                                        </div>
                                    </div>
                                }
                            }
                            else
                            {
                                <p class="text-muted small">No addresses defined.</p>
                            }

                            <h6 class="mt-4">Signature</h6>
                            <div class="p-2 bg-body-secondary border rounded">
                                <code class="text-break small">@ri.Signature</code>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
