@page
@model TransitModel
@{
    ViewData["Title"] = "Transit Tunnels";
}

<div class="row mb-3">
    <div class="col-12">
        <h1 class="mb-4">Transit Tunnels</h1>
        <p class="text-muted">Tunnels that this router is participating in for other I2P routers</p>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card">
            <div class="card-body">
                <h6 class="card-subtitle mb-2 text-muted">Total</h6>
                <h3 class="mb-0">@Model.TotalTransitTunnels</h3>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card">
            <div class="card-body">
                <h6 class="card-subtitle mb-2 text-muted">Gateway</h6>
                <h3 class="mb-0 text-warning">@Model.GatewayCount</h3>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card">
            <div class="card-body">
                <h6 class="card-subtitle mb-2 text-muted">Transit</h6>
                <h3 class="mb-0 text-info">@Model.TransitCount</h3>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card">
            <div class="card-body">
                <h6 class="card-subtitle mb-2 text-muted">Endpoint</h6>
                <h3 class="mb-0 text-success">@Model.EndpointCount</h3>
            </div>
        </div>
    </div>
</div>

@if (Model.TransitTunnels.Any())
{
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Active Transit Tunnels</h5>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-hover table-striped">
                            <thead>
                                <tr>
                                    <th>Tunnel ID</th>
                                    <th>From</th>
                                    <th>To</th>
                                    <th>Role</th>
                                    <th>Messages</th>
                                    <th>Bandwidth</th>
                                    <th>Last Activity</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var tunnel in Model.TransitTunnels)
                                {
                                    <tr>
                                        <td class="router-hash">@tunnel.TunnelId</td>
                                        <td class="router-hash small">
                                            @if (tunnel.FromRouterHash != null)
                                            {
                                                <a href="/RouterDetail?hash=@tunnel.FromRouter">@tunnel.FromRouter</a>
                                            }
                                            else
                                            {
                                                @tunnel.FromRouter
                                            }
                                        </td>
                                        <td class="router-hash small">
                                            @if (tunnel.ToRouterHash != null)
                                            {
                                                <a href="/RouterDetail?hash=@Uri.EscapeDataString(tunnel.ToRouter)">@tunnel.ToRouter</a>
                                            }
                                            else
                                            {
                                                @tunnel.ToRouter
                                            }
                                        </td>
                                        <td>
                                            <span class="badge bg-@(tunnel.IsGateway ? "warning" : tunnel.IsEndpoint ? "success" : "info")">
                                                @(tunnel.IsGateway ? "Gateway" : tunnel.IsEndpoint ? "Endpoint" : "Transit")
                                            </span>
                                        </td>
                                        <td>@tunnel.MessageCount</td>
                                        <td class="small">
                                            <span title="Send">&#x2191; @tunnel.SendBitrateKBps.ToString("F1") KB/s</span><br/>
                                            <span title="Receive">&#x2193; @tunnel.ReceiveBitrateKBps.ToString("F1") KB/s</span>
                                        </td>
                                        <td class="small text-muted">@tunnel.LastActivity.ToString("HH:mm:ss")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="row">
        <div class="col-12">
            <div class="alert alert-info">
                <h5 class="alert-heading">No Transit Tunnels</h5>
                <p class="mb-0">
                    This router is not currently participating in any transit tunnels for other routers.
                    Transit tunnels will appear as the router becomes more established in the network.
                </p>
            </div>
        </div>
    </div>
}

<div class="row mt-4">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">About Transit Tunnels</h5>
            </div>
            <div class="card-body">
                <p class="mb-2">
                    <strong>Transit Tunnels:</strong> Your router is used as an intermediate hop in someone else's tunnel.
                    Traffic passes through your router but you are neither the origin nor the destination.
                </p>
                <p class="mb-0">
                    <strong>Endpoint Tunnels:</strong> Your router is the final hop in an inbound tunnel for another router.
                    You forward the decrypted messages to their final destination router.
                </p>
            </div>
        </div>
    </div>
</div>

