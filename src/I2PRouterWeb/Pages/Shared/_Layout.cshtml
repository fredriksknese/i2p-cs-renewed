<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - I2P Router Console</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/I2PRouterWeb.styles.css" asp-append-version="true"/>
    <style>
        .navbar-brand {
            font-weight: bold;
        }

        .stat-card {
            border-left: 4px solid var(--app-highlight);
        }

        .activity-log {
            max-height: 400px;
            overflow-y: auto;
        }

        .badge-category {
            min-width: 80px;
        }

        .tunnel-chain {
            font-family: monospace;
            font-size: 0.85rem;
        }

        .router-hash {
            font-family: monospace;
            font-size: 0.85rem;
            word-break: break-all;
        }
    </style>
</head>
<body>
<div class="d-flex">
    <nav class="sidebar bg-black text-white p-3 vh-100 sticky-top overflow-auto">
        <a class="navbar-brand text-white d-block mb-3" asp-page="/Index">I2P Router Console</a>
        <hr class="text-white-50" />
        <ul class="nav nav-pills flex-column mb-auto">
            <li class="nav-item">
                <a class="nav-link text-white" asp-page="/Index">Dashboard</a>
            </li>
            <li class="nav-item">
                <a class="nav-link text-white" asp-page="/Tunnels">Tunnels</a>
            </li>
            <li class="nav-item">
                <a class="nav-link text-white" asp-page="/Transit">Transit</a>
            </li>
            <li class="nav-item">
                <a class="nav-link text-white" asp-page="/Routers">Routers</a>
            </li>
            <li class="nav-item">
                <a class="nav-link text-white" asp-page="/Transports">Transports</a>
            </li>
            <li class="nav-item">
                <a class="nav-link text-white" asp-page="/LeaseSets">Lease Sets</a>
            </li>
            <li class="nav-item">
                <a class="nav-link text-white" asp-page="/NetDbLookup">NetDB Lookup</a>
            </li>
            <li class="nav-item">
                <a class="nav-link text-white" asp-page="/NetDbLog">NetDb Log</a>
            </li>
            <li class="nav-item">
                <a class="nav-link text-white" asp-page="/NetDbStats">NetDB Stats</a>
            </li>
            <li class="nav-item">
                <a class="nav-link text-white" asp-page="/TunnelBuildLogs">Build Logs</a>
            </li>
            <li class="nav-item">
                <a class="nav-link text-white" asp-page="/ConnectionLogs">Conn Logs</a>
            </li>
            <li class="nav-item">
                <a class="nav-link text-white" asp-page="/HttpProxyLogs">Proxy Logs</a>
            </li>
            <li class="nav-item">
                <a class="nav-link text-white" asp-page="/Activity">Activity</a>
            </li>
            <li class="nav-item">
                <a class="nav-link text-white" asp-page="/Settings">Settings</a>
            </li>
        </ul>
    </nav>

    <div class="flex-grow-1 d-flex flex-column min-vh-100">
        <div class="container-fluid mt-4">
            <main role="main" class="pb-3">
                @RenderBody()
            </main>
        </div>

        <footer class="border-top footer text-muted mt-auto py-3">
            <div class="container-fluid">
                &copy; 2026 - I2P Router Web Console
            </div>
        </footer>
    </div>
</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>

@await RenderSectionAsync("Scripts", false)
</body>
</html>
