@page
@using I2PCore.SessionLayer
@model SettingsModel
@{
    ViewData["Title"] = "Settings";
}

<div class="row">
    <div class="col-12">
        <h1 class="mb-4">Router Settings</h1>
    </div>
</div>

@if (Model.SuccessMessage != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @Model.SuccessMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">Network Configuration</h5>
            </div>
            <div class="card-body">
                <form method="post">
                    <div class="mb-3">
                        <label for="externalAddress" class="form-label">External IP Address</label>
                        <input type="text" class="form-control" id="externalAddress"
                               asp-for="ExternalAddress" placeholder="Leave empty for auto-detection">
                        <div class="form-text">Your external IP address. Leave blank to auto-detect.</div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="tcpPort" class="form-label">TCP Port</label>
                            <input type="number" class="form-control" id="tcpPort"
                                   asp-for="TcpPort" min="1024" max="65535" required>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="udpPort" class="form-label">UDP Port</label>
                            <input type="number" class="form-control" id="udpPort"
                                   asp-for="UdpPort" min="1024" max="65535" required>
                        </div>
                    </div>

                    <div class="mb-3 form-check">
                        <input type="checkbox" class="form-check-input" id="isFirewalled"
                               asp-for="IsFirewalled">
                        <label class="form-check-label" for="isFirewalled">
                            Router is behind a firewall
                        </label>
                        <div class="form-text">Check this if your router cannot accept incoming connections.</div>
                    </div>

                    <div class="mb-3 form-check">
                        <input type="checkbox" class="form-check-input" id="useIPv6"
                               asp-for="UseIPv6">
                        <label class="form-check-label" for="useIPv6">
                            Enable IPv6
                        </label>
                        <div class="form-text">Enable IPv6 support for connections.</div>
                    </div>

                    <div class="mb-3 form-check">
                        <input type="checkbox" class="form-check-input" id="enableSSU2"
                               asp-for="EnableSSU2">
                        <label class="form-check-label" for="enableSSU2">
                            Enable SSU2 (UDP Transport)
                        </label>
                        <div class="form-text">Disable to use NTCP2 (TCP) only. Reduces console log noise.</div>
                    </div>

                    <div class="mb-3 form-check">
                        <input type="checkbox" class="form-check-input" id="floodfillEnabled"
                               asp-for="FloodfillEnabled">
                        <label class="form-check-label" for="floodfillEnabled">
                            Enable Floodfill
                        </label>
                        <div class="form-text">Contribute to the network by acting as a Floodfill router (DHT node).
                        </div>
                    </div>

                    <hr/>
                    <h6 class="mb-3">Connection Limits</h6>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="maxNtcp2Inbound" class="form-label">Max Inbound NTCP2</label>
                            <input type="number" class="form-control" id="maxNtcp2Inbound"
                                   asp-for="MaxNtcp2InboundConnections" min="1" max="10000" required>
                            <div class="form-text">Limit for incoming NTCP2 sessions.</div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="maxNtcp2Outbound" class="form-label">Max Outbound NTCP2</label>
                            <input type="number" class="form-control" id="maxNtcp2Outbound"
                                   asp-for="MaxNtcp2OutboundConnections" min="1" max="10000" required>
                            <div class="form-text">Limit for outgoing NTCP2 sessions.</div>
                        </div>
                    </div>

                    <hr/>
                    <h6 class="mb-3">Transit Tunnels</h6>

                    <div class="mb-3">
                        <label for="maxTransitTunnels" class="form-label">Maximum Transit Tunnels</label>
                        <input type="number" class="form-control" id="maxTransitTunnels"
                               asp-for="MaxTransitTunnels" min="0" max="10000" required>
                        <div class="form-text">Maximum number of concurrent transit tunnels this router will accept.
                            Current: @Model.CurrentMaxTransitTunnels</div>
                    </div>

                    <div class="mb-3">
                        <label for="transitSharePercent" class="form-label">Transit Bandwidth Share (%)</label>
                        <input type="number" class="form-control" id="transitSharePercent"
                               asp-for="TransitSharePercent" min="0" max="100" required>
                        <div class="form-text">Percentage of total bandwidth allocated to transit traffic.</div>
                    </div>

                    <button type="submit" class="btn btn-outline-primary">Apply Settings</button>
                </form>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">Current Settings</h5>
            </div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-6">External IP:</dt>
                    <dd class="col-sm-6">@(Model.CurrentExternalAddress ?? "Auto")</dd>

                    <dt class="col-sm-6">Detected IP:</dt>
                    <dd class="col-sm-6">
                        @if (Model.DetectedExternalAddress != null)
                        {
                            <span class="text-success">@Model.DetectedExternalAddress</span>
                            <small class="text-muted d-block">From peer reports</small>
                        }
                        else
                        {
                            <span class="text-muted">Not detected yet</span>
                        }
                    </dd>

                    <dt class="col-sm-6">TCP Port:</dt>
                    <dd class="col-sm-6">@Model.CurrentTcpPort</dd>

                    <dt class="col-sm-6">UDP Port:</dt>
                    <dd class="col-sm-6">@Model.CurrentUdpPort</dd>

                    <dt class="col-sm-6">Max NTCP2 In/Out:</dt>
                    <dd class="col-sm-6">@Model.CurrentMaxNtcp2InboundConnections / @Model.CurrentMaxNtcp2OutboundConnections</dd>

                    <dt class="col-sm-6">Firewalled:</dt>
                    <dd class="col-sm-6">
                        <span class="badge bg-@(Model.CurrentIsFirewalled ? "warning" : "success")">
                            @(Model.CurrentIsFirewalled ? "Yes" : "No")
                        </span>
                    </dd>

                    <dt class="col-sm-6">IPv6:</dt>
                    <dd class="col-sm-6">
                        <span class="badge bg-@(Model.CurrentUseIPv6 ? "success" : "secondary")">
                            @(Model.CurrentUseIPv6 ? "Enabled" : "Disabled")
                        </span>
                    </dd>

                    <dt class="col-sm-6">SSU2:</dt>
                    <dd class="col-sm-6">
                        <span class="badge bg-@(Model.CurrentEnableSSU2 ? "success" : "secondary")">
                            @(Model.CurrentEnableSSU2 ? "Enabled" : "Disabled")
                        </span>
                    </dd>

                    <dt class="col-sm-6">Floodfill:</dt>
                    <dd class="col-sm-6">
                        <span class="badge bg-@(Model.CurrentFloodfillEnabled ? "success" : "secondary")">
                            @(Model.CurrentFloodfillEnabled ? "Enabled" : "Disabled")
                        </span>
                    </dd>
                </dl>
            </div>
        </div>

        <div class="card mt-3">
            <div class="card-header">
                <h5 class="mb-0">Help</h5>
            </div>
            <div class="card-body">
                <p class="card-text small">
                    <strong>Port Forwarding:</strong> If you're behind a firewall, configure port forwarding
                    on your router to improve connectivity.
                </p>
                <p class="card-text small mb-0">
                    <strong>IPv6:</strong> Only enable if your network and ISP support IPv6.
                </p>
            </div>
        </div>
    </div>
</div>
